# LAN MCU sdkconfig overrides
# TCP tuning for 921600 baud PPP (BDP = 90KB/s × 300ms RTT ≈ 27KB)
# Use 14400 (10×MSS) to sustain CDN flow without 37s zero-window abort
CONFIG_LWIP_TCP_WND_DEFAULT=14400
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=14400
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
# RTO 500ms: retransmit chain (0.5+1+2+4=7.5s) finishes before CDN's 18s TLS timeout
CONFIG_LWIP_TCP_RTO_TIME=500
# Allow mbedTLS to use PSRAM for SSL context allocation (~50KB needed for TLS handshake)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Allow esp_https_ota to work with plain HTTP URLs (ThingsBoard local HTTP mode).
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
# --- OTA connection stability fixes ---
# LCP Echo: detect dead PPP link within 15s (5s interval × 3 fails)
# instead of waiting 388s for TCP RTO chain to expire.
CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_LCP_ECHOINTERVAL=5
CONFIG_LWIP_LCP_MAXECHOFAILS=3
# TCP max retransmits: limit RTO backoff chain to ~63s (safety fallback
# if LCP Echo is not available on the peer side).
# Default is 12 (~388s). 7 retries = 0.5+1+2+4+8+16+32 = ~63s.
CONFIG_LWIP_TCP_MAXRTX=7
